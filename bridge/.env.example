# Copy to bridge/.env and fill in. bridge/.env is gitignored; start.sh copies it to the phone the first time only
# (after that, edit /opt/rethink/bridge/.env on the phone).

# Required: the live voice model (OpenAI GPT-Live).
OPENAI_API_KEY=
# Who the assistant answers for, e.g. Asha
OWNER_NAME=
# Optional: a sentence or two about the owner that the assistant may use on calls.
OWNER_CONTEXT=

# Grocery ordering (Experiment 03). Leave ORDER_ALLOWED_CALLERS empty and nobody can order.
# Numbers allowed to order, comma-separated; the last 10 digits are compared.
ORDER_ALLOWED_CALLERS=
# The saved Blinkit address to deliver to: text that appears in only one of them, e.g. its first line.
DELIVERY_ADDRESS=
# Refuse orders above this total, in rupees.
MAX_ORDER_RUPEES=500

# Optional overrides
# LIVE_VOICE=marin
# LIVE_MODEL=gpt-live-1
# BACKEND_MODEL=gpt-6-luna
